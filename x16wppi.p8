; x16wppi.p8 - pictures for X16 Write as a bank library: X16WPPI.BIN, RAM bank 54 at $A000.
; Loaded at start by pix.p8 together with X16WPPL.BIN (x16wppl.p8, RAM bank 56 at $A200: the Picture
; button, reading BMX files, RTF import, tool tips), which calls this library through its jump table.
; This one keeps the picture table and does what happens while editing: drawing pictures in the page,
; keeping keys / selections / paste from breaking them, and RTF export. It calls X16 Write's main-RAM
; routines through wpsyms.p8 (generated by tools/gen_wpsyms.py for bank 54): JSRFAR maps this bank
; back before returning.
;
; Pictures are BMX files (the Commander X16 bitmap format, version 1, uncompressed, 1/2/4/8 bpp,
; up to 640 x 1024). A picture is a run of document lines (one screen row each, no text):
; O_PIC = picture id 1..15, O_PROW = the line's row in the picture, byte 0 = the picture's line count.
; Its data lives in RAM banks 28..53 (whole banks, 26 x 8 KB), and on machines with more than 1 MB also
; in the banks above the document's lines (145.., up to 110 more): 256 bytes of palette map (BMX colour
; -> screen colour) and then the BMX file itself. Pictures no document line refers to any more
; (deleted, New, Open) are freed the next time memory is needed.
;
; On screen a picture is shown in the 16 Sunset colours, centred, scaled with the same rule as the
; sync hub uses for Word: f = min(1, 496 / w, 640 / h); w*f screen pixels wide and h*f/2 rows high
; (the screen's pixels are twice as tall as wide). In RTF a picture is {\*\xwpbmx HEX} between
; paragraphs (other programs skip it; the hub turns it into a real picture in .docx and .rtf).
;
; This code can't switch RAM banks (it runs in one): doc.bxfer copies between a bank and main RAM,
; through doc's paragraph buffer sbch (640 bytes, free while nothing is being edited).

%address  $A000
%memtop   $C000
%output   library

%import syslib
%import wpsyms

main {
    %jmptable (
        pi.setup,       ; $A003  r0 = &vid.text as the WP sees it -> A true if this library matches
        pi.key_entry,   ; $A006  r0L = key -> A true if handled (or refused) here
        pi.delsel,      ; $A009  -> A true if the selection touched pictures (and was deleted here)
        pi.draw_entry,  ; $A00C  r0L = screen row of the page view; doc.LBV holds its picture line
        pi.export,      ; $A00F  doc.LB holds a picture line: write the picture as RTF (first line)
        pi.paste,       ; $A012  before a paste: off a picture onto a new line after it
        ; for X16WPPL.BIN
        pi.e_alloc,     ; $A015  r0 + r1L<<16 = bytes -> A new picture id with its banks, 0 = no room
        pi.e_xfer,      ; $A018  r0L id, r1 + r2L<<16 offset, r3 main RAM, r4 count, r5L 1 = into the picture
        pi.e_free,      ; $A01B  r0L id
        pi.e_begin,     ; $A01E  -> A id with the longest free run of banks (r1L banks), 0 = none
        pi.e_shrink,    ; $A021  r0L id, r1L banks to keep
        pi.e_set,       ; $A024  r0L id: its sizes from doc.LB (see e_set)
        pi.e_lines,     ; $A027  r0L id, r1 line, r2L 1 = reuse the line at the end -> A false if full
        pi.e_hc,        ; $A02A  X16WPHC.BIN (bank 55) is set up: draw pictures with it
    )

    sub start() {
    }
}

pi {
    const ubyte O_LEN = 240
    const ubyte O_FLG = 241
    const ubyte O_TBL = 245
    const ubyte O_PIC = 246
    const ubyte O_PROW = 247
    const ubyte F_SOFT = 1
    const ubyte ROW0 = 5                ; view.ROW0
    const ubyte MAXPIC = 15
    const ubyte DB0 = 28                ; data banks 28..53 (bown 0..25)
    const ubyte NLO = 26
    const ubyte NDB = 137               ; + bown 26 = a wall, 27..136 = banks hi0.. (machines over 1 MB)
    const ubyte MAXLINES = 40           ; 320 screen rows at most

    ; per picture (index = id 1..15)
    bool[16] p_used
    ubyte[16] p_bank                    ; first data bank
    ubyte[16] p_start                   ; its index in bown
    ubyte[16] p_nb                      ; data banks
    uword[16] p_w
    uword[16] p_h
    uword[16] p_dw                      ; shown size (screen pixels / rows)
    uword[16] p_dh
    uword[16] p_bpl                     ; BMX bytes per scanline
    uword[16] p_data                    ; offset of the pixel data in the BMX
    ubyte[16] p_bpp
    ubyte[16] p_lines
    uword[16] p_lenlo                   ; BMX file length
    ubyte[16] p_lenhi
    ubyte[NDB] bown                     ; data bank owner (picture id, 0 = free, 255 = not there)
    ubyte hi0                           ; first bank above the document lines (doc.p8: banks 64..144)
    bool[16] refd

    ubyte[256] map                      ; palette map of picture mapid
    ubyte mapid
    ubyte gen                           ; changes when a picture id is freed or (re)set (X16WPHC.BIN)
    bool hc                             ; X16WPHC.BIN draws pictures in 256 colours on layer 1

    extsub @bank 55 $AE06 = hc_row() clobbers(X, Y) -> bool @A
    uword s_first                       ; span()
    uword s_last

    ; Picture icon (icon 21 = glyphs 42/43 of font slot 3): a framed landscape with a sun
    ubyte[16] icon = [$7f,$40,$40,$40,$44,$4e,$5f,$7f, $fe,$02,$32,$32,$02,$82,$c2,$fe]

    sub setup() -> bool {
        if cx16.r0 != wp.CHECK
            return false
        ; banks above the document's lines: numbanks - (64 + up to 81 banks of lines), see doc.p8
        uword nb = cx16.numbanks()
        uword top = nb
        if top > 145
            top = 145
        if top < 64
            top = 64
        hi0 = lsb(top)
        ubyte b
        for b in 0 to NDB - 1 {
            bown[b] = 0
            if b == NLO
                bown[b] = 255                           ; the wall between the two pools
            else if b > NLO {
                if ((b - (NLO + 1)) as uword) + top >= nb
                    bown[b] = 255                       ; no such bank on this machine
            }
        }
        ubyte i
        sys.set_irqd()
        cx16.vaddr(1, $7800 + 42 * 8, 0, 1)            ; font slot 3 = VRAM $17800
        for i in 0 to 15
            cx16.VERA_DATA0 = icon[i]
        sys.clear_irqd()
        return true
    }

    sub status(uword s) {
        wp.set_status(s)
        wp.draw_status()
    }

    sub changed(uword l) {
        wp.need_repag = true
        wp.mark_from(l)
        wp.rd_mode = 2
        wp.modified = true
    }

    ; ---------------- picture data in the banks ----------------
    ; n bytes of picture id's data from offset off into main RAM at dst (out: from main RAM)
    sub xfer(ubyte id, long off, uword dst, uword n, bool out) {
        uword a
        uword c
        while n != 0 {
            a = lsw(off) & $1fff
            c = $2000 - a
            if c > n
                c = n
            wp.bxfer(p_bank[id] + lsb(off >> 13), $a000 + a, dst, c, out as ubyte)     ; a run never crosses the wall
            off += c
            dst += c
            n -= c
        }
    }

    sub plen(ubyte id) -> long {
        return ((p_lenhi[id] as long) << 16) | p_lenlo[id]
    }

    ; frees every picture no document line refers to
    sub gc() {
        ubyte i
        for i in 0 to 15
            refd[i] = false
        uword l
        ubyte id
        for l in 0 to wp.nlines - 1 {
            id = wp.meta(l, O_PIC)
            if id != 0 and id <= MAXPIC
                refd[id] = true
        }
        for i in 1 to MAXPIC {
            if p_used[i] and not refd[i]
                free(i)
        }
    }

    sub free(ubyte id) {
        ubyte b
        for b in 0 to NDB - 1 {
            if bown[b] == id
                bown[b] = 0
        }
        p_used[id] = false
        if mapid == id
            mapid = 0
        gen++
    }

    ; a free picture id, or 0
    sub new_id() -> ubyte {
        ubyte i
        for i in 1 to MAXPIC {
            if not p_used[i]
                return i
        }
        return 0
    }

    ; the longest run of free data banks: r_start / r_len
    ubyte r_start
    ubyte r_len
    sub best_run() {
        ubyte b = 0
        ubyte s
        r_len = 0
        while b < NDB {
            if bown[b] != 0 {
                b++
                continue
            }
            s = b
            while b < NDB and bown[b] == 0
                b++
            if b - s > r_len {
                r_len = b - s
                r_start = s
            }
        }
    }

    ; take banks for a new picture of size bytes (map + BMX): its id, or 0
    sub alloc(long size) -> ubyte {
        gc()
        ubyte id = new_id()
        if id == 0
            return 0
        ubyte nb = lsb((size + 8191) >> 13)
        best_run()
        if r_len < nb
            return 0
        claim(id, r_start, nb)
        return id
    }

    sub claim(ubyte id, ubyte start, ubyte nb) {
        ubyte b
        for b in start to start + nb - 1
            bown[b] = id
        p_used[id] = true
        p_start[id] = start
        if start < NLO
            p_bank[id] = DB0 + start
        else
            p_bank[id] = hi0 + start - (NLO + 1)
        p_nb[id] = nb
        if mapid == id
            mapid = 0
        gen++
    }

    ; ---------------- picture lines ----------------
    sub pid(uword l) -> ubyte {
        if l >= wp.nlines
            return 0
        return wp.meta(l, O_PIC)
    }

    ; first and last line of the picture on line l
    sub span(uword l) {
        s_first = l - wp.meta(l, O_PROW)
        s_last = s_first + wp.meta(l, 0) - 1
    }

    ; inserts the lines of picture id at line at; reuse: the line at at + lines - 1 already exists
    ; (empty: the RTF reader's first line). False if the document is full (nothing inserted)
    sub make_lines(ubyte id, uword at, bool reuse) -> bool {
        ubyte n = p_lines[id]
        ubyte r
        ubyte k = n
        if reuse
            k--
        if k != 0 {
            for r in 0 to k - 1 {
                if not wp.insert_blank(at) {
                    while r != 0 {
                        wp.delete_line(at)
                        r--
                    }
                    wp.full_error = true
                    return false
                }
            }
        }
        for r in 0 to n - 1 {
            wp.setmeta(at + r, 0, n)
            wp.setmeta(at + r, O_PIC, id)
            wp.setmeta(at + r, O_PROW, r)
        }
        return true
    }

    sub remove(uword l) {
        span(l)
        uword n = s_last - s_first + 1
        repeat n
            wp.delete_line(s_first)
        if wp.nlines == 0
            void wp.insert_blank(0)
    }

    ; ---------------- drawing ----------------
    ; r0L = screen row of the page view, r1L = its kind (doc.vrow_info: 0 = a document line, which
    ; doc.LBV holds). Called for every row: X16WPHC.BIN must hear about rows without pictures too.
    sub draw_entry() {
        ubyte sr = cx16.r0L
        ubyte id = 0
        uword lbv = wp.LBV
        if cx16.r1L == 0 {
            id = @(lbv + O_PIC)
            if id > MAXPIC or not p_used[id]
                id = 0
        }
        if hc {
            ; the first source line of the row (and the remainder) for X16WPHC.BIN, which has no room
            ; for long multiplication / division
            long t = 0
            long sy = 0
            if id != 0 {
                uword dy = (@(lbv + O_PROW) as uword) * 8
                t = (dy as long) * p_h[id]
                sy = t / p_dh[id]
                t -= sy * p_dh[id]
                sy = sy * p_bpl[id] + 256 + p_data[id]
            }
            cx16.r0L = sr
            cx16.r1L = id
            cx16.r2L = @(lbv + O_PROW)
            cx16.r3 = p_w[id]
            cx16.r4 = p_h[id]
            cx16.r5 = p_dw[id]
            cx16.r6 = p_dh[id]
            cx16.r7 = p_bpl[id]
            cx16.r8L = p_bpp[id]
            cx16.r9L = p_bank[id]
            cx16.r11 = lsw(t)
            cx16.r12 = lsw(sy)
            cx16.r13L = lsb(msw(sy))
            cx16.r13H = gen
            if hc_row()
                return
        }
        if id != 0
            draw(sr)
    }

    sub e_hc() {
        hc = true
    }

    ubyte[8] sh2 = [6, 4, 2, 0, 6, 4, 2, 0]

    sub draw(ubyte sr) {
        uword lbv = wp.LBV
        ubyte id = @(lbv + O_PIC)
        if id == 0 or id > MAXPIC or not p_used[id]
            return
        uword buf = wp.sbch
        if mapid != id {
            xfer(id, 0, buf, 256, false)
            sys.memcopy(buf, &map, 256)
            mapid = id
        }
        uword w = p_w[id]
        uword h = p_h[id]
        uword dw = p_dw[id]
        uword dh = p_dh[id]
        uword bpl = p_bpl[id]
        ubyte bpp = p_bpp[id]
        uword xs = (64 + (512 - dw) / 2) & $fffe
        uword dy = (@(lbv + O_PROW) as uword) * 8
        uword y = ((ROW0 + sr) as uword) * 8
        uword sy
        long va
        uword x
        uword sx
        uword acc
        ubyte c0
        ubyte v
        bool hi
        repeat 8 {
            if dy >= dh
                return
            sy = lsw((dy as long) * h / dh)
            xfer(id, 256 + (p_data[id] as long) + (sy as long) * bpl, buf, bpl, false)
            va = (y as long) * 320 + xs / 2
            sx = 0
            acc = 0
            x = 0
            hi = true
            sys.set_irqd()
            cx16.vaddr(lsb(msw(va)), lsw(va), 0, 1)
            while x < dw {
                when bpp {
                    8 -> v = @(buf + sx)
                    4 -> {
                        v = @(buf + (sx >> 1))
                        if sx & 1 == 0
                            v >>= 4
                        v &= 15
                    }
                    2 -> v = (@(buf + (sx >> 2)) >> sh2[lsb(sx) & 3]) & 3
                    else -> v = (@(buf + (sx >> 3)) >> (7 - (lsb(sx) & 7))) & 1
                }
                v = map[v]
                if hi
                    c0 = v << 4
                else
                    cx16.VERA_DATA0 = c0 | v
                hi = not hi
                acc += w
                while acc >= dw {
                    acc -= dw
                    sx++
                }
                x++
            }
            sys.clear_irqd()
            dy++
            y++
        }
    }

    ; ---------------- keys, selections, paste ----------------
    sub key_entry() -> bool {
        return key(cx16.r0L)
    }

    sub key(ubyte k) -> bool {
        bool del = k == 8 or k == 20 or k == 127 or k == 25
        bool ent = k == 13
        if not (del or ent or k == 9 or (k >= 32 and k < 127) or k >= 161)
            return false
        if wp.sel_active {
            if not touches()
                return false
            remove_sel()
            return del                      ; typing replaces the selection: go on with the key
        }
        uword cur = wp.curline
        if pid(cur) != 0 {
            if del {
                ; Backspace / Delete on a picture deletes the picture
                remove(cur)
                if s_first >= wp.nlines
                    s_first = wp.nlines - 1
                wp.curline = s_first
                wp.curcol = 0
                changed(s_first)
                status(iso:"Picture deleted")
                return true
            }
            ; Enter, or typing: on a new line after the picture
            span(cur)
            if not wp.insert_blank(s_last + 1) {
                wp.full_error = true
                return true
            }
            wp.curline = s_last + 1
            wp.curcol = 0
            changed(cur)
            return ent
        }
        ubyte ln = wp.meta(cur, O_LEN)
        if (k == 8 or k == 20) and wp.curcol == 0 and cur > 0 and pid(cur - 1) != 0 {
            if wp.meta(cur, O_FLG) & F_SOFT != 0
                return false
            ; never merge text into a picture: an empty line goes, else the cursor goes onto the picture
            if ln == 0 and cur + 1 < wp.nlines {
                wp.delete_line(cur)
                changed(cur - 1)
            }
            wp.curline = cur - 1
            wp.curcol = 0
            return true
        }
        if (k == 127 or k == 25) and pid(cur + 1) != 0 and wp.curcol >= ln and wp.para_last(cur) == cur {
            if ln == 0 {
                wp.delete_line(cur)
                changed(cur)
            }
            return true
        }
        return false
    }

    sub touches() -> bool {
        wp.sel_norm()
        uword l
        for l in wp.sn_l1 to wp.sn_l2 {
            if pid(l) != 0
                return true
        }
        return false
    }

    sub delsel() -> bool {
        if not touches()
            return false
        remove_sel()
        return true
    }

    ; deletes a selection that touches pictures: the pictures go whole, the text around them is
    ; deleted normally (doc.delete_selection, which no longer finds pictures)
    sub remove_sel() {
        wp.sel_norm()
        uword l1 = wp.sn_l1
        ubyte c1 = wp.sn_c1
        uword l2 = wp.sn_l2
        ubyte c2 = wp.sn_c2
        bool none = false
        uword l = l2
        uword n
        repeat {
            if pid(l) != 0 {
                span(l)
                n = s_last - s_first + 1
                repeat n
                    wp.delete_line(s_first)
                if l2 >= s_first {
                    if l2 <= s_last {
                        if s_first == 0
                            none = true
                        else {
                            l2 = s_first - 1
                            c2 = wp.meta(l2, O_LEN)
                        }
                    } else
                        l2 -= n
                }
                if l1 >= s_first {
                    l1 = s_first
                    c1 = 0
                }
                if s_first == 0 or s_first <= l1
                    break
                l = s_first - 1
                continue
            }
            if l <= l1
                break
            l--
        }
        if wp.nlines == 0
            void wp.insert_blank(0)
        if l1 >= wp.nlines {
            l1 = wp.nlines - 1
            c1 = wp.meta(l1, O_LEN)
            none = true
        }
        wp.sel_active = false
        changed(l1)
        if not none and (l1 < l2 or (l1 == l2 and c1 < c2)) {
            wp.sel_l = l1
            wp.sel_c = c1
            wp.curline = l2
            wp.curcol = c2
            wp.sel_active = true
            wp.delete_selection()
            return
        }
        wp.curline = l1
        if c1 > wp.meta(l1, O_LEN)
            c1 = wp.meta(l1, O_LEN)
        wp.curcol = c1
    }

    sub paste() {
        if wp.sel_active
            return
        uword cur = wp.curline
        if pid(cur) == 0
            return
        span(cur)
        if wp.insert_blank(s_last + 1) {
            wp.curline = s_last + 1
            wp.curcol = 0
            changed(cur)
        } else
            wp.full_error = true
    }

    ; ---------------- the Picture button ----------------

    ; ---------------- RTF ----------------
    sub ps(uword s) {
        while @(s) != 0 {
            wp.put_c(@(s))
            s++
        }
    }

    sub export() {
        uword lb = wp.LB
        if @(lb + O_PROW) != 0
            return
        ubyte id = @(lb + O_PIC)
        if id > MAXPIC or not p_used[id]
            return
        uword sb = wp.sbch
        long off = 256
        long left = plen(id)
        uword c
        ubyte i
        ps(iso:"{\\*\\xwpbmx ")
        while left > 0 {
            c = 64
            if left < 64
                c = lsw(left)
            xfer(id, off, sb, c, false)
            for i in 0 to lsb(c) - 1
                wp.put_hex(@(sb + i))
            ps(iso:"\r\n")
            off += c
            left -= c
        }
        ps(iso:"}\r\n")
    }

    ; ---------------- entries for X16WPPL.BIN ----------------
    sub e_alloc() -> ubyte {
        return alloc(((cx16.r1L as long) << 16) | cx16.r0)
    }

    sub e_xfer() {
        ubyte id = cx16.r0L
        long off = ((cx16.r2L as long) << 16) | cx16.r1
        uword dst = cx16.r3
        uword n = cx16.r4
        bool out = cx16.r5L != 0
        xfer(id, off, dst, n, out)
    }

    sub e_free() {
        free(cx16.r0L)
    }

    sub e_begin() -> ubyte {
        gc()
        ubyte id = new_id()
        best_run()
        cx16.r1L = 0
        if id == 0 or r_len == 0
            return 0
        claim(id, r_start, r_len)
        cx16.r1L = r_len
        return id
    }

    sub e_shrink() {
        ubyte id = cx16.r0L
        ubyte nb = cx16.r1L
        ubyte start = p_start[id]
        free(id)
        claim(id, start, nb)
    }

    ; doc.LB: w, h, shown w, shown h, bytes per scanline, data offset (words), bpp, lines (bytes),
    ; BMX length (word + byte)
    sub e_set() {
        ubyte id = cx16.r0L
        uword lb = wp.LB
        p_w[id] = peekw(lb)
        p_h[id] = peekw(lb + 2)
        p_dw[id] = peekw(lb + 4)
        p_dh[id] = peekw(lb + 6)
        p_bpl[id] = peekw(lb + 8)
        p_data[id] = peekw(lb + 10)
        p_bpp[id] = @(lb + 12)
        p_lines[id] = @(lb + 13)
        p_lenlo[id] = peekw(lb + 14)
        p_lenhi[id] = @(lb + 16)
        if mapid == id
            mapid = 0
        gen++
    }

    sub e_lines() -> bool {
        ubyte id = cx16.r0L
        uword at = cx16.r1
        bool reuse = cx16.r2L != 0
        return make_lines(id, at, reuse)
    }
}
